<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Admin Dashboard - Hike Horizon</title>
  <link rel="stylesheet" href="/css/output.css">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700;800&family=DM+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
  <style>
    body { font-family: 'DM Sans', sans-serif; }
    h1, h2, h3, h4, h5, h6 { font-family: 'Outfit', sans-serif; }
  </style>
</head>
<body class="bg-gray-100 min-h-screen flex">
  <!-- Sidebar -->
  <aside class="w-64 bg-night text-white min-h-screen">
    <div class="p-4">
      <div class="flex items-center space-x-2 mb-8">
        <svg class="w-8 h-8" viewBox="0 0 40 40" fill="none"><path d="M20 2L35 12V28L20 38L5 28V12L20 2Z" fill="#F4A460"/><path d="M20 8L30 15V25L20 32L10 25V15L20 8Z" fill="#2D5A27"/><circle cx="20" cy="20" r="4" fill="#F4A460"/></svg>
        <span class="text-xl font-bold">Admin</span>
      </div>
      <nav class="space-y-2">
        <a href="/admin/dashboard" class="block py-2 px-4 rounded hover:bg-forest <%= path === '/admin/dashboard' ? 'bg-forest' : '' %>">Dashboard</a>
        <a href="/admin/users" class="block py-2 px-4 rounded hover:bg-forest <%= path === '/admin/users' ? 'bg-forest' : '' %>">Users</a>
        <a href="/admin/trails" class="block py-2 px-4 rounded hover:bg-forest <%= path === '/admin/trails' ? 'bg-forest' : '' %>">Trails</a>
        <a href="/admin/hikes" class="block py-2 px-4 rounded hover:bg-forest <%= path === '/admin/hikes' ? 'bg-forest' : '' %>">Hikes Log</a>
        <hr class="my-4 border-gray-700">
        <a href="/" class="block py-2 px-4 rounded hover:bg-forest">Back to Site</a>
        <a href="/logout" class="block py-2 px-4 rounded hover:bg-forest text-red-400">Logout</a>
      </nav>
    </div>
  </aside>

  <!-- Main Content -->
  <main class="flex-1 p-8">
    <h1 class="text-3xl font-bold text-gray-800 mb-8">Admin Dashboard</h1>
    
    <!-- Stats -->
    <div class="grid grid-cols-1 md:grid-cols-4 gap-6 mb-8">
      <div class="bg-white rounded-xl shadow-lg p-6">
        <div class="text-3xl font-bold text-forest"><%= stats.totalUsers %></div>
        <div class="text-gray-500">Total Users</div>
      </div>
      <div class="bg-white rounded-xl shadow-lg p-6">
        <div class="text-3xl font-bold text-forest"><%= stats.totalTrails %></div>
        <div class="text-gray-500">Total Trails</div>
      </div>
      <div class="bg-white rounded-xl shadow-lg p-6">
        <div class="text-3xl font-bold text-forest"><%= stats.totalHikes %></div>
        <div class="text-gray-500">Total Hikes</div>
      </div>
      <div class="bg-white rounded-xl shadow-lg p-6">
        <div class="text-3xl font-bold text-forest"><%= stats.totalReviews %></div>
        <div class="text-gray-500">Total Reviews</div>
      </div>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
      <!-- Recent Users -->
      <div class="bg-white rounded-xl shadow-lg p-6">
        <h2 class="text-xl font-bold text-gray-800 mb-4">Recent Users</h2>
        <div class="space-y-3">
          <% recentUsers.forEach(function(user) { %>
            <div class="flex items-center justify-between p-3 bg-gray-50 rounded-lg">
              <div class="flex items-center space-x-3">
                <img src="<%= user.avatar %>" class="w-10 h-10 rounded-full">
                <div>
                  <div class="font-semibold text-gray-800"><%= user.username %></div>
                  <div class="text-sm text-gray-500"><%= user.email %></div>
                </div>
              </div>
              <% if (user.is_admin) { %>
                <span class="px-2 py-1 bg-sunset text-white text-xs rounded">Admin</span>
              <% } %>
            </div>
          <% }); %>
        </div>
        <a href="/admin/users" class="block text-center mt-4 text-forest font-semibold">View All Users</a>
      </div>

      <!-- Recent Hikes -->
      <div class="bg-white rounded-xl shadow-lg p-6">
        <h2 class="text-xl font-bold text-gray-800 mb-4">Recent Hikes</h2>
        <div class="space-y-3">
          <% recentHikes.forEach(function(hike) { %>
            <div class="flex items-center justify-between p-3 bg-gray-50 rounded-lg">
              <div>
                <div class="font-semibold text-gray-800"><%= hike.username %> logged <%= hike.trail_name %></div>
                <div class="text-sm text-gray-500"><%= new Date(hike.date).toLocaleDateString() %></div>
              </div>
              <div class="text-forest font-semibold"><%= hike.distance %> km</div>
            </div>
          <% }); %>
        </div>
        <a href="/admin/hikes" class="block text-center mt-4 text-forest font-semibold">View All Hikes</a>
      </div>
    </div>
  </main>
</body>
</html>
