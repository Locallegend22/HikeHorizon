<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Hikes Log - Admin</title>
  <link rel="stylesheet" href="/css/output.css">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700;800&family=DM+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
  <style>
    body { font-family: 'DM Sans', sans-serif; }
    h1, h2, h3, h4, h5, h6 { font-family: 'Outfit', sans-serif; }
  </style>
</head>
<body class="bg-gray-100 min-h-screen flex">
  <aside class="w-64 bg-night text-white min-h-screen">
    <div class="p-4">
      <div class="flex items-center space-x-2 mb-8">
        <svg class="w-8 h-8" viewBox="0 0 40 40" fill="none"><path d="M20 2L35 12V28L20 38L5 28V12L20 2Z" fill="#F4A460"/><path d="M20 8L30 15V25L20 32L10 25V15L20 8Z" fill="#2D5A27"/><circle cx="20" cy="20" r="4" fill="#F4A460"/></svg>
        <span class="text-xl font-bold">Admin</span>
      </div>
      <nav class="space-y-2">
        <a href="/admin/dashboard" class="block py-2 px-4 rounded hover:bg-forest">Dashboard</a>
        <a href="/admin/users" class="block py-2 px-4 rounded hover:bg-forest">Users</a>
        <a href="/admin/trails" class="block py-2 px-4 rounded hover:bg-forest">Trails</a>
        <a href="/admin/hikes" class="block py-2 px-4 rounded bg-forest">Hikes Log</a>
        <hr class="my-4 border-gray-700">
        <a href="/" class="block py-2 px-4 rounded hover:bg-forest">Back to Site</a>
        <a href="/logout" class="block py-2 px-4 rounded hover:bg-forest text-red-400">Logout</a>
      </nav>
    </div>
  </aside>

  <main class="flex-1 p-8">
    <h1 class="text-3xl font-bold text-gray-800 mb-8">Hikes Log</h1>

    <div class="bg-white rounded-xl shadow-lg overflow-hidden">
      <table class="w-full">
        <thead class="bg-gray-50">
          <tr>
            <th class="px-6 py-3 text-left text-sm font-semibold text-gray-600">User</th>
            <th class="px-6 py-3 text-left text-sm font-semibold text-gray-600">Trail</th>
            <th class="px-6 py-3 text-left text-sm font-semibold text-gray-600">Date</th>
            <th class="px-6 py-3 text-left text-sm font-semibold text-gray-600">Distance</th>
            <th class="px-6 py-3 text-left text-sm font-semibold text-gray-600">Duration</th>
            <th class="px-6 py-3 text-left text-sm font-semibold text-gray-600">Status</th>
          </tr>
        </thead>
        <tbody>
          <% hikes.forEach(function(hike) { %>
            <tr class="border-t border-gray-100">
              <td class="px-6 py-4 font-medium text-gray-800"><%= hike.username %></td>
              <td class="px-6 py-4 text-gray-600"><%= hike.trail_name %></td>
              <td class="px-6 py-4 text-gray-600"><%= new Date(hike.date).toLocaleDateString() %></td>
              <td class="px-6 py-4 text-forest font-semibold"><%= hike.distance %> km</td>
              <td class="px-6 py-4 text-gray-600"><%= hike.duration || '-' %></td>
              <td class="px-6 py-4">
                <% if (hike.completed) { %>
                  <span class="px-2 py-1 bg-green-100 text-green-800 text-xs rounded">Completed</span>
                <% } else { %>
                  <span class="px-2 py-1 bg-yellow-100 text-yellow-800 text-xs rounded">Incomplete</span>
                <% } %>
              </td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    </div>
  </main>
</body>
</html>
