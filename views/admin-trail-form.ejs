<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= trail ? 'Edit Trail' : 'Add Trail' %> - Admin</title>
  <link rel="stylesheet" href="/css/output.css">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700;800&family=DM+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
  <style>
    body { font-family: 'DM Sans', sans-serif; }
    h1, h2, h3, h4, h5, h6 { font-family: 'Outfit', sans-serif; }
  </style>
</head>
<body class="bg-gray-100 min-h-screen flex">
  <aside class="w-64 bg-night text-white min-h-screen">
    <div class="p-4">
      <div class="flex items-center space-x-2 mb-8">
        <svg class="w-8 h-8" viewBox="0 0 40 40" fill="none"><path d="M20 2L35 12V28L20 38L5 28V12L20 2Z" fill="#F4A460"/><path d="M20 8L30 15V25L20 32L10 25V15L20 8Z" fill="#2D5A27"/><circle cx="20" cy="20" r="4" fill="#F4A460"/></svg>
        <span class="text-xl font-bold">Admin</span>
      </div>
      <nav class="space-y-2">
        <a href="/admin/dashboard" class="block py-2 px-4 rounded hover:bg-forest">Dashboard</a>
        <a href="/admin/users" class="block py-2 px-4 rounded hover:bg-forest">Users</a>
        <a href="/admin/trails" class="block py-2 px-4 rounded bg-forest">Trails</a>
        <a href="/admin/hikes" class="block py-2 px-4 rounded hover:bg-forest">Hikes Log</a>
        <hr class="my-4 border-gray-700">
        <a href="/" class="block py-2 px-4 rounded hover:bg-forest">Back to Site</a>
        <a href="/logout" class="block py-2 px-4 rounded hover:bg-forest text-red-400">Logout</a>
      </nav>
    </div>
  </aside>

  <main class="flex-1 p-8">
    <h1 class="text-3xl font-bold text-gray-800 mb-8"><%= trail ? 'Edit Trail' : 'Add New Trail' %></h1>

    <form action="<%= trail ? '/admin/trails/' + trail.id : '/admin/trails' %>" method="POST" class="bg-white rounded-xl shadow-lg p-6 max-w-3xl">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <div class="md:col-span-2">
          <label class="block text-gray-700 font-medium mb-2">Trail Name</label>
          <input type="text" name="name" value="<%= trail ? trail.name : '' %>" required class="w-full px-4 py-2 border border-gray-300 rounded-lg">
        </div>

        <div>
          <label class="block text-gray-700 font-medium mb-2">Location</label>
          <input type="text" name="location" value="<%= trail ? trail.location : '' %>" required class="w-full px-4 py-2 border border-gray-300 rounded-lg" placeholder="e.g., Batangas">
        </div>

        <div>
          <label class="block text-gray-700 font-medium mb-2">Difficulty</label>
          <select name="difficulty" class="w-full px-4 py-2 border border-gray-300 rounded-lg">
            <option value="easy" <%= trail && trail.difficulty === 'easy' ? 'selected' : '' %>>Easy</option>
            <option value="moderate" <%= trail && trail.difficulty === 'moderate' ? 'selected' : '' %>>Moderate</option>
            <option value="hard" <%= trail && trail.difficulty === 'hard' ? 'selected' : '' %>>Hard</option>
          </select>
        </div>

        <div>
          <label class="block text-gray-700 font-medium mb-2">Distance (km)</label>
          <input type="number" step="0.1" name="distance" value="<%= trail ? trail.distance : '' %>" required class="w-full px-4 py-2 border border-gray-300 rounded-lg">
        </div>

        <div>
          <label class="block text-gray-700 font-medium mb-2">Elevation Gain (m)</label>
          <input type="number" name="elevation_gain" value="<%= trail ? trail.elevation_gain : '' %>" required class="w-full px-4 py-2 border border-gray-300 rounded-lg">
        </div>

        <div>
          <label class="block text-gray-700 font-medium mb-2">Estimated Time</label>
          <input type="text" name="estimated_time" value="<%= trail ? trail.estimated_time : '' %>" class="w-full px-4 py-2 border border-gray-300 rounded-lg" placeholder="e.g., 4-5 hours">
        </div>

        <div>
          <label class="block text-gray-700 font-medium mb-2">Entry Fee (PHP)</label>
          <input type="number" name="entry_fee" value="<%= trail ? trail.entry_fee : '' %>" class="w-full px-4 py-2 border border-gray-300 rounded-lg">
        </div>

        <div>
          <label class="block text-gray-700 font-medium mb-2">Latitude</label>
          <input type="number" step="any" name="latitude" value="<%= trail ? trail.latitude : '' %>" class="w-full px-4 py-2 border border-gray-300 rounded-lg">
        </div>

        <div>
          <label class="block text-gray-700 font-medium mb-2">Longitude</label>
          <input type="number" step="any" name="longitude" value="<%= trail ? trail.longitude : '' %>" class="w-full px-4 py-2 border border-gray-300 rounded-lg">
        </div>

        <div>
          <label class="block text-gray-700 font-medium mb-2">Best Season</label>
          <input type="text" name="best_season" value="<%= trail ? trail.best_season : '' %>" class="w-full px-4 py-2 border border-gray-300 rounded-lg" placeholder="e.g., November-April">
        </div>

        <div class="md:col-span-2">
          <label class="block text-gray-700 font-medium mb-2">Image URL</label>
          <input type="url" name="image_url" value="<%= trail ? trail.image_url : '' %>" class="w-full px-4 py-2 border border-gray-300 rounded-lg" placeholder="https://...">
        </div>

        <div class="md:col-span-2">
          <label class="block text-gray-700 font-medium mb-2">Description</label>
          <textarea name="description" rows="4" class="w-full px-4 py-2 border border-gray-300 rounded-lg"><%= trail ? trail.description : '' %></textarea>
        </div>
      </div>

      <div class="flex gap-4 mt-6">
        <button type="submit" class="bg-forest text-white px-6 py-3 rounded-lg font-semibold hover:bg-forest-dark">
          <%= trail ? 'Update Trail' : 'Add Trail' %>
        </button>
        <a href="/admin/trails" class="px-6 py-3 border border-gray-300 rounded-lg text-gray-600 hover:bg-gray-50">Cancel</a>
      </div>
    </form>
  </main>
</body>
</html>
