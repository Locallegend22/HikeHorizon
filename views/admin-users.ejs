<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Manage Users - Admin</title>
  <link rel="stylesheet" href="/css/output.css">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700;800&family=DM+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
  <style>
    body { font-family: 'DM Sans', sans-serif; }
    h1, h2, h3, h4, h5, h6 { font-family: 'Outfit', sans-serif; }
  </style>
</head>
<body class="bg-gray-100 min-h-screen flex">
  <aside class="w-64 bg-night text-white min-h-screen">
    <div class="p-4">
      <div class="flex items-center space-x-2 mb-8">
        <svg class="w-8 h-8" viewBox="0 0 40 40" fill="none"><path d="M20 2L35 12V28L20 38L5 28V12L20 2Z" fill="#F4A460"/><path d="M20 8L30 15V25L20 32L10 25V15L20 8Z" fill="#2D5A27"/><circle cx="20" cy="20" r="4" fill="#F4A460"/></svg>
        <span class="text-xl font-bold">Admin</span>
      </div>
      <nav class="space-y-2">
        <a href="/admin/dashboard" class="block py-2 px-4 rounded hover:bg-forest">Dashboard</a>
        <a href="/admin/users" class="block py-2 px-4 rounded bg-forest">Users</a>
        <a href="/admin/trails" class="block py-2 px-4 rounded hover:bg-forest">Trails</a>
        <a href="/admin/hikes" class="block py-2 px-4 rounded hover:bg-forest">Hikes Log</a>
        <hr class="my-4 border-gray-700">
        <a href="/" class="block py-2 px-4 rounded hover:bg-forest">Back to Site</a>
        <a href="/logout" class="block py-2 px-4 rounded hover:bg-forest text-red-400">Logout</a>
      </nav>
    </div>
  </aside>

  <main class="flex-1 p-8">
    <h1 class="text-3xl font-bold text-gray-800 mb-8">Manage Users</h1>

    <div class="bg-white rounded-xl shadow-lg overflow-hidden">
      <table class="w-full">
        <thead class="bg-gray-50">
          <tr>
            <th class="px-6 py-3 text-left text-sm font-semibold text-gray-600">User</th>
            <th class="px-6 py-3 text-left text-sm font-semibold text-gray-600">Email</th>
            <th class="px-6 py-3 text-left text-sm font-semibold text-gray-600">Hikes</th>
            <th class="px-6 py-3 text-left text-sm font-semibold text-gray-600">Joined</th>
            <th class="px-6 py-3 text-left text-sm font-semibold text-gray-600">Actions</th>
          </tr>
        </thead>
        <tbody>
          <% users.forEach(function(user) { %>
            <tr class="border-t border-gray-100">
              <td class="px-6 py-4">
                <div class="flex items-center space-x-3">
                  <img src="<%= user.avatar %>" class="w-10 h-10 rounded-full">
                  <span class="font-semibold text-gray-800"><%= user.username %></span>
                  <% if (user.is_admin) { %>
                    <span class="px-2 py-1 bg-sunset text-white text-xs rounded">Admin</span>
                  <% } %>
                </div>
              </td>
              <td class="px-6 py-4 text-gray-600"><%= user.email %></td>
              <td class="px-6 py-4 text-gray-600"><%= user.total_hikes %></td>
              <td class="px-6 py-4 text-gray-600"><%= new Date(user.created_at).toLocaleDateString() %></td>
              <td class="px-6 py-4">
                <form action="/admin/users/<%= user.id %>/toggle-admin" method="POST" class="inline">
                  <button type="submit" class="text-blue-600 hover:underline text-sm mr-3">
                    <%= user.is_admin ? 'Remove Admin' : 'Make Admin' %>
                  </button>
                </form>
                <% if (!user.is_admin) { %>
                <form action="/admin/users/<%= user.id %>/delete" method="POST" class="inline" onsubmit="return confirm('Delete this user?')">
                  <button type="submit" class="text-red-600 hover:underline text-sm">Delete</button>
                </form>
                <% } %>
              </td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    </div>
  </main>
</body>
</html>
