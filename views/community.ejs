<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Community - Hike Horizon</title>
  <link rel="stylesheet" href="/css/output.css">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700;800&family=DM+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
  <style>
    body { font-family: 'DM Sans', sans-serif; }
    h1, h2, h3, h4, h5, h6 { font-family: 'Outfit', sans-serif; }
  </style>
</head>
<body class="bg-sage min-h-screen flex flex-col">
  <%- include('partials/header') %>

  <main class="flex-grow">
    <div class="bg-forest py-12">
      <div class="max-w-7xl mx-auto px-4">
        <h1 class="text-3xl font-bold text-white mb-2">Community</h1>
        <p class="text-gray-200">Connect with fellow hikers</p>
      </div>
    </div>

    <div class="max-w-7xl mx-auto px-4 py-8">
      <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
        <div class="lg:col-span-2">
          <div class="bg-white rounded-xl shadow-lg p-6">
            <h2 class="text-xl font-bold text-gray-800 mb-6">Recent Hikes</h2>
            <% if (recentHikes.length > 0) { %>
              <div class="space-y-4">
                <% recentHikes.forEach(function(hike) { %>
                  <div class="flex items-center space-x-4 p-4 bg-gray-50 rounded-lg">
                    <img src="<%= hike.avatar || '/images/default-avatar.png' %>" class="w-12 h-12 rounded-full">
                    <div class="flex-grow">
                      <div class="flex items-center">
                        <span class="font-semibold text-gray-800"><%= hike.username %></span>
                        <span class="text-gray-500 mx-2">completed</span>
                        <span class="font-semibold text-forest"><%= hike.trail_name %></span>
                      </div>
                      <p class="text-sm text-gray-500"><%= new Date(hike.date).toLocaleDateString() %></p>
                    </div>
                    <div class="text-right">
                      <div class="text-sm font-medium text-forest"><%= hike.duration || '' %></div>
                    </div>
                  </div>
                <% }); %>
              </div>
            <% } else { %>
              <p class="text-gray-500 text-center py-8">No recent hikes. Be the first to log one!</p>
            <% } %>
          </div>
        </div>

        <div class="lg:col-span-1">
          <div class="bg-white rounded-xl shadow-lg p-6 mb-6">
            <h3 class="font-bold text-gray-800 mb-4">Join Our Community</h3>
            <p class="text-gray-600 text-sm mb-4">Connect with thousands of hikers across the Philippines. Share experiences, tips, and adventures.</p>
            <% if (!user) { %>
              <a href="/register" class="block w-full bg-forest text-white py-3 rounded-lg font-semibold text-center hover:bg-forest-dark transition-all">Join Now</a>
            <% } else { %>
              <div class="text-center py-4">
                <p class="text-forest font-semibold">You're part of the community!</p>
              </div>
            <% } %>
          </div>

          <div class="bg-white rounded-xl shadow-lg p-6">
            <h3 class="font-bold text-gray-800 mb-4">Popular Locations</h3>
            <div class="space-y-2">
              <a href="/trails?location=Batangas" class="block p-2 bg-gray-50 rounded hover:bg-forest/10 transition-colors">Batangas</a>
              <a href="/trails?location=Cavite" class="block p-2 bg-gray-50 rounded hover:bg-forest/10 transition-colors">Cavite</a>
              <a href="/trails?location=Bataan" class="block p-2 bg-gray-50 rounded hover:bg-forest/10 transition-colors">Bataan</a>
              <a href="/trails?location=Benguet" class="block p-2 bg-gray-50 rounded hover:bg-forest/10 transition-colors">Benguet</a>
              <a href="/trails?location=Davao" class="block p-2 bg-gray-50 rounded hover:bg-forest/10 transition-colors">Davao</a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </main>

  <%- include('partials/footer') %>
</body>
</html>
