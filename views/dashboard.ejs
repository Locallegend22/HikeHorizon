<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Dashboard - Hike Horizon</title>
  <link rel="stylesheet" href="/css/output.css">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700;800&family=DM+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
  <style>
    body { font-family: 'DM Sans', sans-serif; }
    h1, h2, h3, h4, h5, h6 { font-family: 'Outfit', sans-serif; }
  </style>
</head>
<body class="bg-sage min-h-screen flex flex-col">
  <%- include('partials/header') %>

  <main class="flex-grow">
    <div class="bg-forest py-12">
      <div class="max-w-7xl mx-auto px-4">
        <div class="flex items-center space-x-4">
          <img src="<%= user.avatar || '/images/default-avatar.png' %>" class="w-20 h-20 rounded-full border-4 border-sunset">
          <div>
            <h1 class="text-3xl font-bold text-white"><%= user.username %></h1>
            <p class="text-gray-200"><%= user.experience_level.charAt(0).toUpperCase() + user.experience_level.slice(1) %> Hiker</p>
          </div>
        </div>
      </div>
    </div>

    <div class="max-w-7xl mx-auto px-4 py-8">
      <!-- Stats -->
      <div class="grid grid-cols-1 md:grid-cols-4 gap-4 mb-8">
        <div class="bg-white rounded-xl shadow-lg p-6 text-center">
          <div class="text-3xl font-bold text-forest"><%= stats.totalHikes %></div>
          <div class="text-gray-500">Total Hikes</div>
        </div>
        <div class="bg-white rounded-xl shadow-lg p-6 text-center">
          <div class="text-3xl font-bold text-forest"><%= stats.totalDistance.toFixed(1) %></div>
          <div class="text-gray-500">km Total</div>
        </div>
        <div class="bg-white rounded-xl shadow-lg p-6 text-center">
          <div class="text-3xl font-bold text-forest"><%= stats.uniqueTrails %></div>
          <div class="text-gray-500">Unique Trails</div>
        </div>
        <div class="bg-white rounded-xl shadow-lg p-6 text-center">
          <div class="text-3xl font-bold text-forest"><%= favorites.length %></div>
          <div class="text-gray-500">Favorites</div>
        </div>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
        <!-- Recent Hikes -->
        <div class="lg:col-span-2">
          <div class="bg-white rounded-xl shadow-lg p-6">
            <div class="flex justify-between items-center mb-6">
              <h2 class="text-xl font-bold text-gray-800">Recent Hikes</h2>
              <a href="/user/hikes" class="text-forest font-semibold hover:underline">View All</a>
            </div>
            
            <% if (recentHikes.length > 0) { %>
              <div class="space-y-4">
                <% recentHikes.forEach(function(hike) { %>
                  <div class="flex items-center space-x-4 p-4 bg-gray-50 rounded-lg">
                    <img src="<%= hike.image_url || '/images/default-avatar.png' %>" class="w-16 h-16 rounded-lg object-cover">
                    <div class="flex-grow">
                      <h3 class="font-semibold text-gray-800"><%= hike.trail_name %></h3>
                      <p class="text-sm text-gray-500"><%= hike.location %> • <%= new Date(hike.date).toLocaleDateString() %></p>
                    </div>
                    <div class="text-right">
                      <div class="text-sm font-medium text-forest"><%= hike.distance %> km</div>
                      <div class="text-sm text-gray-500"><%= hike.duration || '' %></div>
                    </div>
                  </div>
                <% }); %>
              </div>
            <% } else { %>
              <p class="text-gray-500 text-center py-8">No hikes logged yet. Start your adventure!</p>
            <% } %>
          </div>
        </div>

        <!-- Sidebar -->
        <div class="lg:col-span-1">
          <!-- Favorites -->
          <div class="bg-white rounded-xl shadow-lg p-6 mb-6">
            <div class="flex justify-between items-center mb-4">
              <h3 class="font-bold text-gray-800">Favorites</h3>
              <a href="/user/favorites" class="text-sm text-forest hover:underline">View All</a>
            </div>
            <% if (favorites.length > 0) { %>
              <div class="space-y-3">
                <% favorites.forEach(function(fav) { %>
                  <a href="/trails/<%= fav.id %>" class="flex items-center space-x-3 group">
                    <img src="<%= fav.image_url %>" class="w-12 h-12 rounded-lg object-cover">
                    <div>
                      <div class="font-medium text-gray-800 group-hover:text-forest"><%= fav.name %></div>
                      <div class="text-sm text-gray-500"><%= fav.location %></div>
                    </div>
                  </a>
                <% }); %>
              </div>
            <% } else { %>
              <p class="text-gray-500 text-sm">No favorites yet</p>
            <% } %>
          </div>

          <!-- Achievements -->
          <div class="bg-white rounded-xl shadow-lg p-6">
            <h3 class="font-bold text-gray-800 mb-4">Achievements</h3>
            <div class="grid grid-cols-3 gap-2">
              <% achievements.forEach(function(ach) { %>
                <div class="text-center p-2">
                  <div class="text-2xl mb-1"><%= ach.icon %></div>
                  <div class="text-xs text-gray-600"><%= ach.name %></div>
                </div>
              <% }); %>
            </div>
          </div>
        </div>
      </div>
    </div>
  </main>

  <%- include('partials/footer') %>
</body>
</html>
