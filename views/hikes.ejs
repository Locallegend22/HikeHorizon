<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>My Hikes - Hike Horizon</title>
  <link rel="stylesheet" href="/css/output.css">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700;800&family=DM+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
  <style>
    body { font-family: 'DM Sans', sans-serif; }
    h1, h2, h3, h4, h5, h6 { font-family: 'Outfit', sans-serif; }
  </style>
</head>
<body class="bg-sage min-h-screen flex flex-col">
  <%- include('partials/header') %>

  <main class="flex-grow">
    <div class="bg-forest py-12">
      <div class="max-w-7xl mx-auto px-4">
        <h1 class="text-3xl font-bold text-white mb-2">My Hikes</h1>
        <p class="text-gray-200">Your hiking history</p>
      </div>
    </div>

    <div class="max-w-7xl mx-auto px-4 py-8">
      <% if (typeof success !== 'undefined' && success) { %>
        <div class="bg-green-100 text-green-800 px-4 py-3 rounded-lg mb-4"><%= success %></div>
      <% } %>
      
      <% if (typeof error !== 'undefined' && error) { %>
        <div class="bg-red-100 text-red-800 px-4 py-3 rounded-lg mb-4"><%= error %></div>
      <% } %>

      <% if (hikes.length > 0) { %>
        <div class="space-y-4">
          <% hikes.forEach(function(hike) { %>
            <div class="bg-white rounded-xl shadow-lg p-6 flex flex-col md:flex-row items-start md:items-center gap-4">
              <img src="<%= hike.image_url %>" class="w-24 h-24 rounded-lg object-cover">
              <div class="flex-grow">
                <h3 class="text-xl font-bold text-gray-800"><%= hike.trail_name %></h3>
                <p class="text-gray-500"><%= hike.location %></p>
                <p class="text-sm text-gray-400"><%= new Date(hike.date).toLocaleDateString() %> • <%= hike.difficulty %></p>
                <% if (hike.notes) { %>
                  <p class="text-sm text-gray-600 mt-2"><%= hike.notes %></p>
                <% } %>
              </div>
              <div class="text-right">
                <div class="text-lg font-semibold text-forest"><%= hike.distance %> km</div>
                <div class="text-sm text-gray-500"><%= hike.duration || '' %></div>
                <% if (hike.completed) { %>
                  <span class="inline-block mt-2 px-2 py-1 bg-green-100 text-green-800 text-xs rounded">Completed</span>
                <% } %>
              </div>
            </div>
          <% }); %>
        </div>
      <% } else { %>
        <div class="bg-white rounded-xl shadow-lg p-12 text-center">
          <p class="text-gray-500 mb-4">No hikes logged yet</p>
          <a href="/plan" class="text-forest font-semibold hover:underline">Start hiking!</a>
        </div>
      <% } %>
    </div>
  </main>

  <%- include('partials/footer') %>
</body>
</html>
