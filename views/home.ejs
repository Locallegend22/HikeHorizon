<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Hike Horizon - Discover Your Next Adventure</title>
  <link rel="stylesheet" href="/css/output.css">
  <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700;800&family=DM+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
  <style>
    :root { --primary: #2D5A27; --primary-dark: #1E3D1A; --secondary: #F4A460; }
    body { font-family: 'DM Sans', sans-serif; }
    h1, h2, h3, h4, h5, h6 { font-family: 'Outfit', sans-serif; }
    .hero-gradient { 
      background: linear-gradient(180deg, #1a3a1a 0%, #2D5A27 50%, #3d6b35 100%);
      position: relative;
      overflow: hidden;
    }
    .hero-gradient::before {
      content: '';
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      bottom: 0;
      background: url('https://images.unsplash.com/photo-1551632811-561732d1e306?w=1920') center/cover;
      opacity: 0.25;
    }
    .hero-gradient::after {
      content: '';
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      bottom: 0;
      background: linear-gradient(180deg, rgba(26,58,26,0.85) 0%, rgba(45,90,39,0.75) 100%);
    }
    .hero-content {
      position: relative;
      z-index: 10;
    }
  </style>
</head>
<body class="bg-sage min-h-screen flex flex-col">
  <%- include('partials/header') %>

  <main class="flex-grow">
    <!-- Hero Section -->
    <section class="hero-gradient min-h-[70vh] flex items-center justify-center text-white">
      <div class="text-center px-4 py-20 hero-content">
        <h1 class="text-4xl md:text-6xl font-bold mb-6 animate-fade-in drop-shadow-lg">Discover Your Next Adventure</h1>
        <p class="text-xl md:text-2xl mb-8 text-white max-w-2xl mx-auto animate-slide-up drop-shadow-md">Explore beautiful trails across the Philippines. Find your perfect hike based on difficulty, location, and more.</p>
        
        <!-- Search Form -->
        <form action="/trails" method="GET" class="max-w-3xl mx-auto bg-white/15 backdrop-blur-sm rounded-xl p-4 md:p-6 animate-slide-up stagger-2 hero-content border border-white/20 shadow-xl">
          <div class="grid grid-cols-1 md:grid-cols-4 gap-4">
            <div class="md:col-span-2">
              <input type="text" name="search" placeholder="Search trails..." class="w-full px-4 py-3 rounded-lg bg-white text-gray-800 border-0 focus:ring-2 focus:ring-sunset">
            </div>
            <div>
              <select name="location" class="w-full px-4 py-3 rounded-lg bg-white text-gray-800 border-0 focus:ring-2 focus:ring-sunset">
                <option value="">All Locations</option>
                <option value="Batangas">Batangas</option>
                <option value="Cavite">Cavite</option>
                <option value="Bataan">Bataan</option>
                <option value="Davao">Davao</option>
                <option value="Benguet">Benguet</option>
              </select>
            </div>
            <div>
              <select name="difficulty" class="w-full px-4 py-3 rounded-lg bg-white text-gray-800 border-0 focus:ring-2 focus:ring-sunset">
                <option value="">Any Difficulty</option>
                <option value="easy">Easy</option>
                <option value="moderate">Moderate</option>
                <option value="hard">Hard</option>
              </select>
            </div>
          </div>
          <button type="submit" class="w-full md:w-auto mt-4 bg-sunset text-white px-8 py-3 rounded-lg font-semibold hover:bg-orange-400 transition-all hover:scale-[1.02]">
            Find Trails
          </button>
        </form>

        <!-- Quick Stats -->
        <div class="flex flex-wrap justify-center gap-8 mt-12 animate-slide-up stagger-3 hero-content">
          <div class="text-center">
            <div class="text-3xl font-bold text-sunset drop-shadow-md"><%= stats.totalTrails %></div>
            <div class="text-white/90 drop-shadow-sm">Trails</div>
          </div>
          <div class="text-center">
            <div class="text-3xl font-bold text-sunset drop-shadow-md"><%= stats.totalUsers %></div>
            <div class="text-white/90 drop-shadow-sm">Hikers</div>
          </div>
          <div class="text-center">
            <div class="text-3xl font-bold text-sunset drop-shadow-md"><%= stats.totalHikes %></div>
            <div class="text-white/90 drop-shadow-sm">Hikes Logged</div>
          </div>
        </div>
      </div>
    </section>

    <!-- Featured Trails -->
    <section class="py-16 bg-white">
      <div class="max-w-7xl mx-auto px-4">
        <div class="text-center mb-12">
          <h2 class="text-3xl md:text-4xl font-bold text-forest mb-4">Featured Trails</h2>
          <p class="text-gray-600 max-w-2xl mx-auto">Discover our most popular hiking destinations loved by the community</p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
          <% featuredTrails.forEach(function(trail, index) { %>
            <div class="card group">
              <div class="relative overflow-hidden">
                <img src="<%= trail.image_url %>" alt="<%= trail.name %>" class="w-full h-48 object-cover transition-transform duration-300 group-hover:scale-110">
                <div class="absolute top-3 right-3">
                  <span class="px-3 py-1 rounded-full text-sm font-medium
                    <%= trail.difficulty === 'easy' ? 'bg-green-100 text-green-800' : 
                       trail.difficulty === 'moderate' ? 'bg-yellow-100 text-yellow-800' : 
                       'bg-red-100 text-red-800' %>">
                    <%= trail.difficulty.charAt(0).toUpperCase() + trail.difficulty.slice(1) %>
                  </span>
                </div>
              </div>
              <div class="p-5">
                <h3 class="text-xl font-bold text-gray-800 mb-2 group-hover:text-forest transition-colors">
                  <a href="/trails/<%= trail.id %>"><%= trail.name %></a>
                </h3>
                <p class="text-gray-500 text-sm mb-3 flex items-center">
                  <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
                  <%= trail.location %>
                </p>
                <div class="flex items-center justify-between text-sm text-gray-600">
                  <div class="flex items-center space-x-3">
                    <span class="flex items-center">
                      <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6"/></svg>
                      <%= trail.distance %> km
                    </span>
                    <span class="flex items-center">
                      <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 10l7-7m0 0l7 7m-7-7v18"/></svg>
                      <%= trail.elevation_gain %>m
                    </span>
                  </div>
                  <div class="flex items-center">
                    <span class="text-sunset mr-1">★</span>
                    <%= trail.avg_rating ? parseFloat(trail.avg_rating).toFixed(1) : 'New' %> (<%= trail.review_count %>)
                  </div>
                </div>
              </div>
            </div>
          <% }); %>
        </div>

        <div class="text-center mt-10">
          <a href="/trails" class="btn-primary inline-flex items-center">
            View All Trails
            <svg class="w-5 h-5 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
          </a>
        </div>
      </div>
    </section>

    <!-- Features Section -->
    <section class="py-16 bg-sage">
      <div class="max-w-7xl mx-auto px-4">
        <div class="text-center mb-12">
          <h2 class="text-3xl md:text-4xl font-bold text-forest mb-4">Why Choose Hike Horizon?</h2>
          <p class="text-gray-600 max-w-2xl mx-auto">Everything you need for your hiking adventures</p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8">
          <div class="text-center p-6">
            <div class="w-16 h-16 mx-auto mb-4 bg-forest/10 rounded-full flex items-center justify-center">
              <svg class="w-8 h-8 text-forest" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 20l-5.447-2.724A1 1 0 013 16.382V5.618a1 1 0 011.447-.894L9 7m0 13l6-3m-6 3V7m6 10l4.553 2.276A1 1 0 0021 18.382V7.618a1 1 0 00-.553-.894L15 4m0 13V4m0 0L9 7"/></svg>
            </div>
            <h3 class="text-lg font-semibold mb-2">Trail Finder</h3>
            <p class="text-gray-600 text-sm">Search and filter trails by location, difficulty, distance, and more</p>
          </div>

          <div class="text-center p-6">
            <div class="w-16 h-16 mx-auto mb-4 bg-forest/10 rounded-full flex items-center justify-center">
              <svg class="w-8 h-8 text-forest" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 20l-5.447-2.724A1 1 0 013 16.382V5.618a1 1 0 011.447-.894L9 7m0 13l6-3m-6 3V7m6 10l4.553 2.276A1 1 0 0021 18.382V7.618a1 1 0 00-.553-.894L15 4m0 13V4m0 0L9 7"/></svg>
            </div>
            <h3 class="text-lg font-semibold mb-2">Interactive Maps</h3>
            <p class="text-gray-600 text-sm">View trails on an interactive map with GPS tracking</p>
          </div>

          <div class="text-center p-6">
            <div class="w-16 h-16 mx-auto mb-4 bg-forest/10 rounded-full flex items-center justify-center">
              <svg class="w-8 h-8 text-forest" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/></svg>
            </div>
            <h3 class="text-lg font-semibold mb-2">Safety First</h3>
            <p class="text-gray-600 text-sm">Emergency contacts, weather alerts, and safety tips</p>
          </div>

          <div class="text-center p-6">
            <div class="w-16 h-16 mx-auto mb-4 bg-forest/10 rounded-full flex items-center justify-center">
              <svg class="w-8 h-8 text-forest" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"/></svg>
            </div>
            <h3 class="text-lg font-semibold mb-2">Community</h3>
            <p class="text-gray-600 text-sm">Connect with fellow hikers and share experiences</p>
          </div>
        </div>
      </div>
    </section>

    <!-- CTA Section -->
    <section class="py-16 bg-forest text-white">
      <div class="max-w-4xl mx-auto px-4 text-center">
        <h2 class="text-3xl md:text-4xl font-bold mb-4">Ready to Start Your Adventure?</h2>
        <p class="text-xl text-gray-200 mb-8">Join our community of hikers and discover the beauty of Philippines trails</p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a href="/register" class="bg-sunset text-white px-8 py-3 rounded-lg font-semibold hover:bg-orange-400 transition-all hover:scale-[1.02]">
            Join Now - It's Free
          </a>
          <a href="/trails" class="border-2 border-white text-white px-8 py-3 rounded-lg font-semibold hover:bg-white hover:text-forest transition-all">
            Explore Trails
          </a>
        </div>
      </div>
    </section>
  </main>

  <%- include('partials/footer') %>

  <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
  <script src="/js/main.js"></script>
</body>
</html>
